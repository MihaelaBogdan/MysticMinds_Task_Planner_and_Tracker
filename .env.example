PORT=5000
# Example Postgres URL. In Vercel, this is usually auto-populated if you add a persistent store.
# POSTGRES_URL="postgres://user:password@host:port/database?sslmode=require"
# If POSTGRES_URL is not set, it falls back to local SQLite.
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:5173
